// app.rc — Win32 resources for NetLens.win32.
//
// Pulled in by CMakeLists.txt. RC compiler inherits NETLENS_VERSION_* defines
// from target_compile_definitions and the source-dir include path from
// target_include_directories, so the macros below resolve at rcc-time.

#include "Resource.h"
#include <winres.h>

// ---------------------------------------------------------------------------
// Side-by-side manifest (Common-Controls v6 + PerMonitorV2 DPI + UTF-8 ACP).
// Path is relative to this .rc file; both live at the project root.
// ---------------------------------------------------------------------------
1 RT_MANIFEST "app.manifest"

// Application icon — shown in title bar, Alt-Tab, taskbar, Explorer.
IDI_NETLENS    ICON   "resources\\app.ico"

// 3389 Software Outsourcing logo — shown in the About publisher card.
IDB_3389_LOGO  BITMAP "resources\\3389-logo.bmp"

// ---------------------------------------------------------------------------
// Accelerators
// ---------------------------------------------------------------------------
IDR_ACCEL ACCELERATORS
{
    VK_F5,        IDM_FILE_START,        VIRTKEY
    VK_ESCAPE,    IDM_FILE_CANCEL,       VIRTKEY
    "L",          IDM_FILE_CLEAR,        VIRTKEY, CONTROL
    "E",          IDM_FILE_EXPORT_CSV,   VIRTKEY, CONTROL
    "H",          IDM_FILE_EXPORT_HTML,  VIRTKEY, CONTROL
    "F",          IDM_FOCUS_SEARCH,      VIRTKEY, CONTROL
    "T",          IDM_TOOLS_CAPTURE,     VIRTKEY, CONTROL
    "W",          IDM_CAPTURE_MAIN,      VIRTKEY, CONTROL
    VK_F1,        IDM_HELP_ABOUT,        VIRTKEY
}

// ---------------------------------------------------------------------------
// Version info
// ---------------------------------------------------------------------------
#ifndef NETLENS_VERSION_MAJOR
  #define NETLENS_VERSION_MAJOR 0
#endif
#ifndef NETLENS_VERSION_MINOR
  #define NETLENS_VERSION_MINOR 1
#endif
#ifndef NETLENS_VERSION_PATCH
  #define NETLENS_VERSION_PATCH 0
#endif
#ifndef NETLENS_VERSION_STR
  #define NETLENS_VERSION_STR "0.1.0"
#endif

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    NETLENS_VERSION_MAJOR, NETLENS_VERSION_MINOR, NETLENS_VERSION_PATCH, 0
    PRODUCTVERSION NETLENS_VERSION_MAJOR, NETLENS_VERSION_MINOR, NETLENS_VERSION_PATCH, 0
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "3389.ro"
            VALUE "FileDescription",  "NetLens \x2014 portable LAN scanner"
            VALUE "ProductName",      "NetLens"
            VALUE "FileVersion",      NETLENS_VERSION_STR
            VALUE "ProductVersion",   NETLENS_VERSION_STR
            VALUE "LegalCopyright",   "Built by 3389.ro"
            VALUE "OriginalFilename", "NetLens.exe"
            VALUE "InternalName",     "NetLens"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
