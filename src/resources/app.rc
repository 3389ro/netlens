// Application icon (multi-resolution: 16/24/32/48/64/128/256). Authored by
// src/resources/make-icon.ps1 — re-run that script to regenerate.
/////////////////////////////////////////////////////////////////////////////

IDI_APP_ICON ICON "NetLens.ico"
